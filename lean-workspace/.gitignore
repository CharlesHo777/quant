# ---- LEAN local data bundle ----
# ~225 MB of sample data restored by `lean init`; never commit it.
data/

# ---- LEAN run outputs ----
backtests/
live/
optimizations/
storage/
*.log

# ---- IDE / debug scaffolding generated by `lean project-create` ----
# Contains machine-specific interpreter paths; regenerated on demand.
.idea/
.vscode/
.vs/

# ---- C# project build output (generated for C# algorithms) ----
bin/
obj/
*.csproj
*.sln
